/* IQS9150EV02 wiring to the right-hand XIAO header (top view):
 *
 * XIAO GND    -> EV02 GND
 * XIAO 3V3    -> EV02 VDD
 * XIAO P1.15  -> EV02 RDY (active-low, open-drain)
 * XIAO P1.14  -> EV02 SDA
 * XIAO P1.13  -> EV02 SCL
 * XIAO P1.12  -> EV02 MCLR (optional; reserved and not driven in Step 1A)
 *
 * Do not add GPIO_PULL_UP to rdy-gpios when the EV02 pull-up is fitted.
 * Never connect XIAO USB VBUS (5 V) to the EV02 supply input.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 14)>,
                <NRF_PSEL(TWIM_SCL, 1, 13)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 14)>,
                <NRF_PSEL(TWIM_SCL, 1, 13)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    iqs9150: trackpad@56 {
        compatible = "azoteq,iqs9150";
        reg = <0x56>;
        rdy-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
    };
};
