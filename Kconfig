menuconfig IQS9150_EV02_DRIVER
    bool "IQS9150 EV02 sensor driver"
    default y
    depends on DT_HAS_AZOTEQ_IQS9150_ENABLED
    select I2C
    help
      Initialize IQS9150 EV02 on the active-low RDY interrupt, then publish
      normalized absolute contact frames. Pointer and gesture policies are
      implemented by separate Travelers Pad function modules.

if IQS9150_EV02_DRIVER

module = IQS9150_EV02_DRIVER
module-str = iqs9150_ev02_driver
source "subsys/logging/Kconfig.template.log_config"

endif

menu "Travelers Pad input functions"

config TRAVELERS_PAD_IQS9150_POINTER
    bool "IQS9150 pointer and scroll function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_POINTER_ENABLED
    select INPUT
    help
      Convert normalized IQS9150 contact frames into relative pointer motion,
      two-finger scrolling. Tap and drag policy is implemented by a separate
      function module. This is intentionally
      separate from the sensor driver.

config TRAVELERS_PAD_IQS9150_FUNCTION_INIT_PRIORITY
    int "IQS9150 function module initialization priority"
    default 51
    depends on TRAVELERS_PAD_IQS9150_POINTER || TRAVELERS_PAD_IQS9150_GRID_KSCAN || TRAVELERS_PAD_IQS9150_EDGE_DIAL_KSCAN || TRAVELERS_PAD_IQS9150_EDGE_HOLD_CONTINUE || TRAVELERS_PAD_IQS9150_MULTIFINGER_ROUTER || TRAVELERS_PAD_IQS9150_TAP_DRAG || TRAVELERS_PAD_IQS9150_MULTIFINGER_GESTURE_KSCAN || TRAVELERS_PAD_IQS9150_MATRIX_INPUT
    help
      Must be later than the IQS9150 sensor driver's device priority (50).

config TRAVELERS_PAD_IQS9150_GRID_KSCAN
    bool "IQS9150 grid and edge gesture KSCAN function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_GRID_KSCAN_ENABLED
    select KSCAN
    help
      Convert short one-finger taps into configurable grid cells or edge actions.

config TRAVELERS_PAD_IQS9150_EDGE_DIAL_KSCAN
    bool "Travelers Pad IQS9150 edge dial KSCAN"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_EDGE_DIAL_KSCAN_ENABLED
    select KSCAN
    help
      Convert motion along enabled pad edges into repeated virtual KSCAN events.

config TRAVELERS_PAD_IQS9150_EDGE_HOLD_CONTINUE
    bool "Travelers Pad IQS9150 edge-hold continuation function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_EDGE_HOLD_CONTINUE_ENABLED
    select INPUT
    help
      Continue a confirmed drag beyond a physical pad edge. Committed two-finger
      scroll is detected but remains output-disabled until its own stage.

config TRAVELERS_PAD_IQS9150_MULTIFINGER_ROUTER
    bool "IQS9150 exclusive multi-finger gesture router"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_MULTIFINGER_ROUTER_ENABLED
    select INPUT
    help
      Classify raw IQS9150 sessions before pointer processing. One-finger
      sessions pass through immediately. Two-finger parallel motion becomes
      scrolling; pinch/rotation and three-or-more-finger sessions are kept
      out of the pointer path for future gesture bindings.

config TRAVELERS_PAD_IQS9150_TAP_DRAG
    bool "IQS9150 multi-finger tap and double-tap drag function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_TAP_DRAG_ENABLED
    select INPUT
    help
      Convert one-, two-, and three-finger taps into left, right, and middle
      clicks. A nearby second tap with the same finger count becomes a drag
      when held. This function receives raw frames, independently of pointer
      and multi-finger gesture routing.

config TRAVELERS_PAD_IQS9150_MULTIFINGER_GESTURE_KSCAN
    bool "IQS9150 three-to-five-finger swipe KSCAN function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_MULTIFINGER_GESTURE_KSCAN_ENABLED
    select KSCAN
    help
      Convert completed three- and four-finger swipes into virtual KSCAN
      positions. Five-finger contact is analysed as independent-coordinate
      Grasp/Release geometry and is log-only until its thresholds are
      verified. Normal ZMK keymap bindings select swipe actions.

config TRAVELERS_PAD_IQS9150_MATRIX_INPUT
    bool "IQS9150 grid input isolation function"
    default y
    depends on IQS9150_EV02_DRIVER && DT_HAS_ZMK_TRAVELERS_PAD_IQS9150_MATRIX_INPUT_ENABLED
    select INPUT
    help
      Copy only active one-or-more-finger absolute X/Y and BTN_TOUCH frames to
      the optional grid input processor. This isolates the grid listener from
      the raw device and avoids idle-frame processing or event suppression
      affecting pointer, tap-drag, and multi-finger modules.

endmenu

config TRAVELERS_PAD_XIAO_BOOT_PROBE
    bool "XIAO USB boot diagnostic"
    default n
    depends on ZMK_USB
    help
      Diagnostic-only startup indicator for distinguishing a missing USB
      enumeration from a failed transition out of the UF2 bootloader.
