#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /*
             * Multi-finger gesture binding template / 多指ジェスチャー割当テンプレート
             *
             * Order / 順序:
             *   3F: left, right, up, down / 3本指: 左、右、上、下
             *   4F: left, right, up, down / 4本指: 左、右、上、下
             *   5F: grasp, release         / 5本指: Grasp、Release
             *
             * This is the current Windows-oriented assignment. Replace each
             * entry with any ordinary ZMK binding, for example `&kp C_VOL_UP`,
             * `&mo 1`, or `&none`.
             *
             * 現在はWindows向けの割当である。必要に応じて `&kp C_VOL_UP`、
             * `&mo 1`、`&none` など任意の通常のZMK bindingへ置き換える。
             */
            bindings = <&kp C_AC_BACK    &kp C_AC_FORWARD &kp PG_UP       &kp PG_DN
                        &kp LG(LEFT)     &kp LG(RIGHT)     &kp LG(UP)      &kp LG(DOWN)
                        &kp LG(M)        &kp LS(LG(M))>;
        };
    };
};
