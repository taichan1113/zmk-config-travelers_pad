#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Selectable-edge test bindings / 任意辺試験用割当
             * Rows 0--2: tap (1--9), 3--5: flick up (Q--O),
             * 6--8: flick down (A--L), 9--11: flick left (Z--.),
             * 12--14: flick right (F1--F9).
             * 行0--2: タップ（1--9）、3--5: 上フリック（Q--O）、
             * 6--8: 下フリック（A--L）、9--11: 左フリック（Z--.）、
             * 12--14: 右フリック（F1--F9）。 */
            bindings = <&kp L &kp R &kp T &kp B>;
        };
    };
};
