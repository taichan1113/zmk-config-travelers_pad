#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        ent_esc_dance: ent_esc_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <800>;
            bindings = <&kp RET>, <&kp ESC>;
        };
        bt_clear_dance: bt_clear_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            /* Two separate down swipes; single swipe never clears pairing.
             * 2回の独立した下スワイプのみ消去。単発は何もしない。 */
            tapping-term-ms = <1500>;
            bindings = <&none>, <&bt BT_CLR>;
        };
        /* The edge dial emits an instantaneous virtual KSCAN tap. &msc is a
         * held input behavior, therefore each macro holds it long enough for
         * one wheel report. MOVE_* values are deliberately used instead of
         * SCRL_*: the larger velocity yields a reliable single step from this
         * short virtual press.
         *
         * エッジダイヤルは仮想KSCANの瞬時タップを出力する。一方&mscは押下中に
         * レポートするBehaviorなので、各マクロがホイール1回分だけ保持する。
         * この短い仮想押下でも確実に動作するよう、SCRL_*ではなくより大きい
         * MOVE_*値を使用する。 */
        edge_scroll_up: edge_scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <24>;
            bindings = <&macro_press &msc MOVE_Y(1200)>,
                       <&macro_release &msc MOVE_Y(1200)>;
        };

        edge_scroll_down: edge_scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <24>;
            bindings = <&macro_press &msc MOVE_Y(-1200)>,
                       <&macro_release &msc MOVE_Y(-1200)>;
        };

        edge_scroll_right: edge_scroll_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <24>;
            bindings = <&macro_press &msc MOVE_X(1200)>,
                       <&macro_release &msc MOVE_X(1200)>;
        };

        edge_scroll_left: edge_scroll_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <24>;
            bindings = <&macro_press &msc MOVE_X(-1200)>,
                       <&macro_release &msc MOVE_X(-1200)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Full input integration bindings / 全入力結合試験用の割当
             * 3/4/5本指はWindows操作、4辺は連続操作へ割り当てる。
             * Map 3/4/5-finger gestures to Windows actions and all edges to
             * continuous host operations.
             *
             * 3F: Mouse Back / Forward / PageUp / PageDown
             * 4F: Win+Left / Right / Up / Down
             * 5F: Win+M / Win+Shift+M
             * Edge: left brightness down/up, right scroll down/up,
             *       top volume up/down, bottom scroll right/left.
             * Transform: pinch in/out = Ctrl+-/Ctrl+= (zoom out/in),
             *            counter-clockwise/clockwise = F15/F16.
             * Tip-Tap: anchor hold / left / right = none / Left / Right.
             * Tip-Tapはanchor保持なし／左矢印／右矢印を割り当てる。 */
            bindings = <&mkp MB5          &mkp MB4          &kp LC(LA(TAB)) &ent_esc_dance
                        &kp LC(LG(RIGHT)) &kp LC(LG(LEFT))  &kp LG(TAB)      &kp LG(DOWN)
                        &kp LG(M)         &kp LS(LG(M))
                        &kp C_BRI_DN      &kp C_BRI_UP      &edge_scroll_down &edge_scroll_up
                        &kp C_VOL_UP      &kp C_VOL_DN      &edge_scroll_right &edge_scroll_left
                        &none         &kp LEFT      &kp RIGHT
                        &kp LC(MINUS)     &kp LC(COLON)     &kp C_BRI_DEC         &kp C_BRI_INC
                        &to 1>;
        };
        bluetooth_management {
            /* Stay in management after selection/clear; hold again to exit.
             * 選択・消去後も管理を維持。再度4本指ホールドで終了。 */
            bindings = <&none &none &none &none
                        &bt BT_NXT &bt BT_PRV &bt BT_SEL 0 &bt_clear_dance
                        &none &none
                        &none &none &none &none &none &none &none &none
                        &trans &none &none
                        &none &none &none &none
                        &to 0>;
        };
    };
};

/* Keyboard-level two-finger scroll tuning / キーボード側の2本指スクロール調整
 * The current tuning listener chain is <&zip_scroll_scaler 1 4>. To customise it,
 * uncomment this block and choose the transform flags and multiplier below.
 * The processor handles only REL_WHEEL/HWHEEL: 1F pointer movement is unchanged.
 *
 * 現在の調整listener chainは <&zip_scroll_scaler 1 4> である。調整する場合は下の
 * blockを有効化し、反転flagと倍率を選ぶ。processorの対象はREL_WHEEL/HWHEELだけで、
 * 1本指ポインタ移動は変化しない。
 *
 * INPUT_TRANSFORM_Y_INVERT: vertical / 縦反転
 * INPUT_TRANSFORM_X_INVERT: horizontal / 横反転
 * scaler <1 2>: twice as fast / 現在の2倍速
 * scaler <1 8>: half as fast / 現在の半速 */

&iqs9150_pointer_listener {
    input-processors
        = <&zip_xy_scaler 4 5>
        , <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>
        , <&zip_scroll_scaler 1 3>
        ;
};
