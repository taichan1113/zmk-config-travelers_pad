#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Edge-dial isolated test / エッジダイヤル単体試験
             * 左辺を下へD、上へU。円形継続も同じD/Uを送る。残りの辺は無効である。
             * Left edge down=D/up=U. Circular continuation sends the same
             * D/U positions. The remaining edges are disabled. */
            bindings = <&kp D &kp U &none &none &none &none &none &none>;
        };
    };
};
