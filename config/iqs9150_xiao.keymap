#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Four-edge dial isolated test / 4辺エッジダイヤル単体試験
             * 各辺の正/負方向を固有の文字へ割り当て、辺と局所円の状態遷移を識別する。
             * Map each edge's positive/negative direction to unique letters
             * so edge and local-circle state transitions can be identified.
             *
             * 左: 下D / 上U, 右: 下R / 上I,
             * 上: 右T / 左Y, 下: 右B / 左N. */
            bindings = <&kp D &kp U &kp R &kp I
                        &kp T &kp Y &kp B &kp N>;
        };
    };
};
