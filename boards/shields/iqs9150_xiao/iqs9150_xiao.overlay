/* IQS9150EV02 / Seeed XIAO nRF52840 wiring (XIAO top view, right header):
 * GND -> EV02 GND       3V3 -> EV02 VDD
 * P1.14 -> EV02 SDA     P1.13 -> EV02 SCL
 * P1.15 -> EV02 RDY
 *
 * P1.12 is deliberately unused in Step 1A. Do not connect it to MCLR yet:
 * the firmware must not reset an EV02 whose GUI configuration is being kept.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zmk-input-matrix/input_matrix.dtsi>

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 14)>,
                <NRF_PSEL(TWIM_SCL, 1, 13)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 14)>,
                <NRF_PSEL(TWIM_SCL, 1, 13)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    iqs9150: trackpad@56 {
        compatible = "azoteq,iqs9150";
        reg = <0x56>;
        rdy-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
        /* Temporary validation aid: report independent two-finger coordinates
         * at INFO level. 実機検証用に2点座標をINFOログへ出力する。 */
        two-finger-diagnostics;
        /* Temporary validation aid: report every valid 3--7 finger contact.
         * 実機検証用に3--7点の有効座標をINFOログへ出力する。 */
        multitouch-diagnostics;
    };
};

/* P1.13--P1.15 are now I2C/RDY and must not be claimed by SPI2. */
&spi2 {
    status = "disabled";
};

/ {
    chosen {
        /* Isolated pointer test profile: no gesture/grid KSCAN source is
         * active. The mock KSCAN merely satisfies ZMK's normal keymap setup.
         * ポインタ単体試験プロファイル: ジェスチャー/格子KSCANを有効にしない。
         * mock KSCANはZMKの通常キーマップ設定を満たすためだけに使う。 */
        zmk,kscan = &iqs9150_kscan;
        zmk,matrix-transform = &iqs9150_transform;
    };

    iqs9150_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <1>;
        map = <RC(0, 0)>;
    };

    iqs9150_kscan: kscan_iqs9150 {
        compatible = "zmk,kscan-mock";
        rows = <1>;
        columns = <1>;
        events = <0>;
    };

    /* Rows 0--14 are reserved for zmk-input-matrix's 5 x 3x3 gesture grid.
     * Rows 15/16 are 3/4-finger left/right/up/down. Row 17 columns 0/1 are
     * 5F Grasp/Release. Only the existing ten multi-finger positions are
     * mapped for now, so importing the grid cannot trigger an action yet.
     * 行0--14はzmk-input-matrixの5種類 x 3x3格子用に予約する。行15/16は
     * 3/4本指の左/右/上/下、行17の列0/1は5本指Grasp/Releaseである。現時点
     * では既存の10個だけをmapするため、格子を導入しても操作は発火しない。 */
    iqs9150_composite_transform: composite_transform {
        compatible = "zmk,matrix-transform";
        rows = <18>;
        columns = <4>;
        /* RC(17, 2) and RC(17, 3) deliberately have no logical position.
         * ZMK matrix transforms may omit unused physical matrix positions.
         * RC(17, 2) とRC(17, 3)には論理位置を作らない。ZMKのmatrix transformは
         * 未使用の物理マトリクス位置をmapから省略できる。 */
        map = <RC(15, 0) RC(15, 1) RC(15, 2) RC(15, 3)
               RC(16, 0) RC(16, 1) RC(16, 2) RC(16, 3)
               RC(17, 0) RC(17, 1)>;
    };

    /* Composite is deliberately the only chosen KSCAN. New optional sources
     * (the edge module next) are added as children without changing keymap
     * ownership or the gesture driver.
     * compositeだけをchosen KSCANにする。次のエッジ機能などの任意ソースは、
     * キーマップや既存ジェスチャードライバを壊さず子ノードとして追加できる。 */
    iqs9150_composite_kscan: iqs9150_composite_kscan {
        compatible = "zmk,kscan-composite";
        status = "disabled";
        rows = <18>;
        columns = <4>;

        matrix_grid {
            kscan = <&kscan_gesture>;
        };

        multifinger_gesture {
            kscan = <&iqs9150_gesture_kscan>;
            row-offset = <15>;
        };
    };

    iqs9150_gesture_kscan: iqs9150_gesture_kscan {
        compatible = "zmk,travelers-pad-iqs9150-multifinger-gesture-kscan";
        status = "disabled";
        input-device = <&iqs9150>;
        swipe-min-move = <180>;
        swipe-max-ms = <700>;
        five-finger-radial-move = <80>;
        five-finger-stable-frames = <3>;
    };

    /* Function module: raw frames are classified before pointer handling.
     * 生フレームはポインタ処理前にジェスチャー種別へ振り分ける。 */
    iqs9150_router: iqs9150_router {
        compatible = "zmk,travelers-pad-iqs9150-multifinger-router";
        status = "disabled";
        input-device = <&iqs9150>;
        scroll-classify-move = <35>;
        geometry-distance-threshold = <30000>;
        geometry-rotation-threshold = <30000>;
    };

    iqs9150_pointer: iqs9150_pointer {
        compatible = "zmk,travelers-pad-iqs9150-pointer";
        /* Bypass the router in this profile. This isolates raw contact to
         * relative-pointer conversion, including its native 2F scrolling.
         * このプロファイルではrouterを迂回する。生接触から相対ポインタ変換と、
         * ポインタ自身の2本指スクロールだけを単独で検証する。 */
        input-device = <&iqs9150>;
        scroll-divisor = <4>;
        scroll-axis-lock-min-move = <12>;
        scroll-axis-lock-ratio = <2>;
        scroll-max-frame-delta = <128>;
    };

    /* Function module: one/two/three-finger tap maps to left/right/middle.
     * A nearby second tap with the same number of fingers starts a drag when
     * held. This consumes raw frames so it can retain tap history even when
     * the router claims a scroll, geometry, or multi-finger gesture.
     * 1/2/3本指タップを左/右/中クリックへ変換する。近い位置で同本数の二回目を
     * ホールドするとドラッグを開始する。ルーターの操作排他中にも履歴を保つため、
     * 生フレームを入力として使う。 */
    iqs9150_tap_drag: iqs9150_tap_drag {
        compatible = "zmk,travelers-pad-iqs9150-tap-drag";
        status = "disabled";
        input-device = <&iqs9150>;
        tap-max-ms = <180>;
        tap-max-move = <75>;
        /* EV02 contact centroids can settle for several report periods
         * after the second finger appears. The router still commits genuine
         * scrolling independently; this value only prevents that settling
         * from rejecting a stationary 2F/3F tap.
         * EV02では2本目の検出後、重心が約2レポート周期安定化する。実際の
         * スクロールはルーターが別に判定するため、この値は静止した2本/3本指
         * タップを安定化中の座標変動で棄却しないためだけに使う。 */
        multifinger-settle-ms = <120>;
        double-tap-max-gap-ms = <250>;
        double-tap-max-distance = <120>;
        drag-start-move = <20>;
    };

    /* Optional function module: short one-finger taps become virtual KSCAN
     * cells. It is disabled by default so ordinary one-finger tap remains a
     * mouse click. Enable it together with a matching chosen zmk,kscan and
     * matrix transform/keymap when gesture-layer input is wanted.
     *
     * 任意の機能モジュール: 短い1本指タップを仮想KSCANセルへ変換する。通常の
     * 1本指タップを左クリックとして維持するため、初期状態では無効にする。 */
    iqs9150_grid: iqs9150_grid {
        compatible = "zmk,travelers-pad-iqs9150-grid-kscan";
        status = "disabled";
        input-device = <&iqs9150>;
        rows = <3>;
        columns = <3>;
        surface-x = <2000>;
        surface-y = <1213>;
        edge-size = <100>;
        /* left, right, top, bottom: each item is <row column>. */
        edge-keys = <2 0>, <2 1>, <2 2>, <1 1>;
        tap-max-ms = <350>;
        tap-max-move = <75>;
    };

    /* Forward function-module output to ZMK's mouse HID endpoint.
     * 機能モジュールの出力をZMKのマウスHIDエンドポイントへ転送する。 */
    iqs9150_pointer_listener: iqs9150_pointer_listener {
        compatible = "zmk,input-listener";
        device = <&iqs9150_pointer>;
    };

    iqs9150_tap_drag_listener: iqs9150_tap_drag_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&iqs9150_tap_drag>;
    };

    /* zmk-input-matrix is an optional grid source; it has no mapped key
     * positions in this step. The listener nevertheless validates the whole
     * input-processor -> KSCAN proxy -> composite path at build/run time.
     * zmk-input-matrixは任意の格子ソースであり、この段階では論理キーを割り当てない。
     * ただしlistenerによってinput processor→KSCAN proxy→compositeの経路を
     * ビルド時・起動時に検証する。 */
    iqs9150_matrix_listener: iqs9150_matrix_listener {
        compatible = "zmk,input-listener";
        /* Receive the private active-touch stream, not raw IQS9150 reports.
         * 生IQS9150レポートではなく、専用の接触中ストリームを受け取る。 */
        device = <&iqs9150_matrix_input>;
        input-processors = <&zip_matrix>;
        /* The grid has no logical mapping in the base firmware. Keep this
         * verification-only listener off until a grid/edge module includes
         * its transform and bindings.
         * 基本ファームには格子の論理割当がない。格子/辺モジュールがtransformと
         * bindingsをincludeするまで、この検証専用listenerは無効にする。 */
        status = "disabled";
    };

    iqs9150_matrix_input: iqs9150_matrix_input {
        compatible = "zmk,travelers-pad-iqs9150-matrix-input";
        input-device = <&iqs9150>;
        one-finger-settle-ms = <45>;
        status = "disabled";
    };
};

/* Standard 3x3 grid input processor. It observes raw absolute coordinate/touch
 * events without suppressing them: Zephyr fans one mutable input event out to
 * every listener, so suppression here could hide a frame from our independent
 * pointer, tap-drag, or multi-finger modules.
 * 格子用input processorは生の絶対座標・タッチを抑止せず監視する。Zephyrは一つの
 * 可変input eventを全listenerへ配信するため、ここでの抑止は独立したポインタ、
 * タップドラッグ、多指モジュールからフレームを隠す可能性がある。 */
&kscan_gesture {
    rows = <15>;
    columns = <3>;
};

&zip_matrix {
    rows = <3>;
    columns = <3>;
    x = <2000>;
    y = <1213>;
    flick-threshold = <100>;
    long-press-ms = <0>;
    /* This listener receives only its private input stream. It can therefore
     * suppress its events without changing raw frames seen by other modules.
     * listenerは専用ストリームだけを受けるため、抑止しても他モジュールが見る
     * 生フレームを変更しない。 */
    suppress-abs;
    suppress-btn-touch;
};
