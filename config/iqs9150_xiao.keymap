#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Edge-dial linear isolated-test bindings / エッジダイヤル直線単体試験用
             * 左辺を下へなぞると D、上へなぞると U を繰り返し送る。残りの辺は
             * ハードウェア設定で無効にしており、将来の割当用に &none とする。
             * Tracing down the left edge repeatedly sends D; tracing up sends
             * U. The other edges are disabled in hardware and remain &none. */
            bindings = <&kp D &kp U &none &none &none &none &none &none>;
        };
    };
};
