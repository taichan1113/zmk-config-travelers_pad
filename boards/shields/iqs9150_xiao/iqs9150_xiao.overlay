/* IQS9150EV02 / Seeed XIAO nRF52840 wiring (XIAO top view, right header):
 * GND -> EV02 GND       3V3 -> EV02 VDD
 * xiao_11 / D10 / P1.15 -> EV02 SDA
 * xiao_10 / D9  / P1.14 -> EV02 SCL
 * xiao_9  / D8  / P1.13 -> EV02 RDY
 * IQS背面パッドへSDA=P1.15、SCL=P1.14、RDY=P1.13を接続する。
 *
 * P1.12 is deliberately unused by the current firmware. Do not connect it to MCLR:
 * the firmware must not reset an EV02 whose GUI configuration is being kept.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <travelers-pad/iqs9150-pointer.dtsi>
#include <zmk-input-matrix/input_matrix.dtsi>

/* Shared pinch start/exclusion threshold / ピンチ開始・scroll除外の共通閾値 */
#define TRAVELERS_PAD_PINCH_START_THRESHOLD 300000

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 15)>,
                <NRF_PSEL(TWIM_SCL, 1, 14)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 15)>,
                <NRF_PSEL(TWIM_SCL, 1, 14)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    iqs9150: trackpad@56 {
        compatible = "azoteq,iqs9150";
        reg = <0x56>;
        rdy-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
        /* Accepted interim idle-resume policy: keep LP2 and original Auto-Prox,
         * use trackpad sensing instead of ALP. Startup readback remains mandatory.
         * 放置後復帰の暫定対策：LP2・元のAuto-Proxを維持しALPを無効化。
         * 通常の接触・healthログは無効、起動時の設定検証は維持。 */
        power-mode-limit = "none";
        diagnostic-disable-alp;
    };
};

/* P1.13--P1.15 are now I2C/RDY and must not be claimed by SPI2. */
&spi2 {
    status = "disabled";
};

/ {
    management_host_gate: management_host_gate {
        compatible = "zmk,travelers-pad-management-gate";
        #input-processor-cells = <0>;
        layer = <1>;
    };
    management_grid_gate: management_grid_gate {
        compatible = "zmk,travelers-pad-management-gate";
        #input-processor-cells = <0>;
        layer = <1>;
        grid-only;
    };
    chosen {
        /* Full input integration: compose 3--5 finger gestures and edge-dial
         * events without changing the ordinary pointer/tap HID path.
         * 全入力結合試験: 通常のポインタ/タップHID経路を変えず、3〜5本指
         * ジェスチャーとエッジダイヤルのKSCANを合成する。 */
        zmk,kscan = &iqs9150_composite_kscan;
        zmk,matrix-transform = &iqs9150_composite_transform;
    };

    iqs9150_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <1>;
        map = <RC(0, 0)>;
    };

    iqs9150_kscan: kscan_iqs9150 {
        compatible = "zmk,kscan-mock";
        rows = <18>;
        columns = <4>;
        events = <0>;
    };

    /* Rows 0--14 remain unused; management uses only four-finger gestures.
     * Rows 15/16 are 3/4-finger left/right/up/down. Row 17 columns 0/1 are
     * 5F Grasp/Release, row 18 columns 0--7 are edge-dial directions, row 19
     * is Tip-Tap, and row 20 contains the four transform directions.
     * Row 17 column 2 is the optional stationary 4F hold action.
     * 行0--14は未使用。管理操作は4本指ジェスチャーだけを使用。
     * 行17の列2は任意の4本指静止ホールド。行15/16は
     * 3/4本指の左/右/上/下、行17の列0/1は5本指Grasp/Releaseである。現時点
     * 行18の列0〜7はエッジダイヤル方向、行19はTip-Tap、行20はtransformの
     * 4方向である。格子のキー割当・転送は無効。 */
    iqs9150_composite_transform: composite_transform {
        compatible = "zmk,matrix-transform";
        rows = <21>;
        columns = <8>;
        /* RC(17, 3) through RC(17, 7) deliberately have no logical position.
         * ZMK matrix transforms may omit unused physical matrix positions.
         * RC(17, 3)以降には論理位置を作らない。ZMKのmatrix transformは
         * 未使用の物理マトリクス位置をmapから省略できる。 */
        map = <RC(15, 0) RC(15, 1) RC(15, 2) RC(15, 3)
               RC(16, 0) RC(16, 1) RC(16, 2) RC(16, 3)
               RC(17, 0) RC(17, 1)
               RC(18, 0) RC(18, 1) RC(18, 2) RC(18, 3)
               RC(18, 4) RC(18, 5) RC(18, 6) RC(18, 7)
               RC(19, 0) RC(19, 1)
               RC(20, 0) RC(20, 1) RC(20, 2) RC(20, 3)
               RC(17, 2) RC(19, 2)>;
    };

    iqs9150_grid_transform: grid_transform {
        compatible = "zmk,matrix-transform";
        rows = <15>;
        columns = <3>;
        /* zmk-input-matrix emits five 3x3 row groups: tap, up, down, left,
         * right. / zmk-input-matrixはタップ、上、下、左、右の各3x3行群を出力する。 */
        map = <RC(0, 0) RC(0, 1) RC(0, 2)
               RC(1, 0) RC(1, 1) RC(1, 2)
               RC(2, 0) RC(2, 1) RC(2, 2)
               RC(3, 0) RC(3, 1) RC(3, 2)
               RC(4, 0) RC(4, 1) RC(4, 2)
               RC(5, 0) RC(5, 1) RC(5, 2)
               RC(6, 0) RC(6, 1) RC(6, 2)
               RC(7, 0) RC(7, 1) RC(7, 2)
               RC(8, 0) RC(8, 1) RC(8, 2)
               RC(9, 0) RC(9, 1) RC(9, 2)
               RC(10, 0) RC(10, 1) RC(10, 2)
               RC(11, 0) RC(11, 1) RC(11, 2)
               RC(12, 0) RC(12, 1) RC(12, 2)
               RC(13, 0) RC(13, 1) RC(13, 2)
               RC(14, 0) RC(14, 1) RC(14, 2)>;
    };

    /* Circular continuation is another trajectory for the same edge action,
     * so it reuses the same one-row KSCAN positions. Each edge has a positive
     * and negative pair. / 円形継続は同じ辺操作の別軌道なので、同じ1行KSCAN位置を
     * 再利用する。各辺には正/負方向の組がある。 */
    iqs9150_edge_dial_transform: edge_dial_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <8>;
        map = <RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3)
               RC(0, 4) RC(0, 5) RC(0, 6) RC(0, 7)>;
    };

    iqs9150_edge_dial: iqs9150_edge_dial {
        compatible = "zmk,travelers-pad-iqs9150-edge-dial-kscan";
        input-device = <&iqs9150_session>;
        rows = <1>;
        columns = <8>;
        surface-x = <2000>;
        surface-y = <1213>;
        /* 各辺から20カウント、80カウント移動ごとに一回発火する。
         * A 20-count edge band acquires the edge; one event is emitted per
         * 80 counts of parallel movement. */
        edge-size = <20>;
        step-move = <80>;
        /* 辺の移動方向に対応する角の局所円へ、80カウント内側で切り替える。
         * Enter the local circle at the corner selected by edge direction. */
        circle-entry-depth = <80>;
        /* 選択した角の中心と平行方向が±180カウント内だけで円へ移行する。 */
        circle-entry-span = <180>;
        circle-step-move = <80>;
        circle-corner-inset-x = <360>;
        circle-corner-inset-y = <313>;
        /* Enable all four edges for the action keymap profile.
         * 操作キーマッププロファイルでは4辺すべてを有効にする。 */
        edge-left;
        edge-right;
        edge-top;
        edge-bottom;
    };

    /* Composite is the only chosen KSCAN. Each virtual source keeps a separate
     * row range, preventing edge and gesture bindings from aliasing.
     * compositeだけをchosen KSCANにする。各仮想ソースは別々の行範囲を使うため、
     * エッジとジェスチャーのbindingが衝突しない。 */
    iqs9150_composite_kscan: iqs9150_composite_kscan {
        compatible = "zmk,kscan-composite";
        status = "okay";
        rows = <21>;
        columns = <8>;

        multifinger_gesture {
            kscan = <&iqs9150_gesture_kscan>;
            row-offset = <15>;
        };

        edge_dial {
            kscan = <&iqs9150_edge_dial>;
            row-offset = <18>;
        };

        tip_tap {
            kscan = <&iqs9150_tip_tap>;
            row-offset = <19>;
        };

        transform_gesture {
            kscan = <&iqs9150_transform_gesture>;
            row-offset = <20>;
        };
    };

    iqs9150_gesture_kscan: iqs9150_gesture_kscan {
        compatible = "zmk,travelers-pad-iqs9150-multifinger-gesture-kscan";
        status = "okay";
        input-device = <&iqs9150_session>;
        swipe-min-move = <180>;
        swipe-max-ms = <700>;
        five-finger-radial-move = <80>;
        five-finger-stable-frames = <3>;
        four-finger-hold-ms = <1000>;
        four-finger-hold-immediate;
        four-finger-hold-slop = <60>;
    };

    iqs9150_tip_tap: iqs9150_tip_tap {
        compatible = "zmk,travelers-pad-iqs9150-tip-tap-kscan";
        input-device = <&iqs9150_session>;
        /* Distinguish an established anchor from staggered two-finger taps.
         * 先に250ms静止したanchorのみTip-Tap候補にする。 */
        anchor-min-hold-ms = <250>;
        // anchor-hold;
        second-contact-timeout-ms = <250>;
        contact-slop = <75>;
        minimum-horizontal-separation = <160>;
        status = "okay";
    };

    /* Pinch/rotation has a dedicated primary owner. It deliberately receives
     * normalized session frames directly, so a transform can suppress both
     * pointer routing and a terminal two-finger tap. */
    /* Full-pad profile enables pinch; rotation stays disabled.
     * 完全pad profileではピンチを有効、回転を無効にする。 */
    /* Keep the router exclusion and transform recognition threshold identical.
     * ルーターのスクロール除外とピンチ認識に同じ閾値を使う。 */
    iqs9150_router {
        geometry-distance-threshold = <TRAVELERS_PAD_PINCH_START_THRESHOLD>;
    };

    iqs9150_transform_gesture {
        status = "okay";
        /* Conservative pinch thresholds: squared-distance changes, not time.
         * ピンチ誤発火・連打を抑える二乗距離差の閾値。時間間隔ではない。 */
        distance-threshold = <TRAVELERS_PAD_PINCH_START_THRESHOLD>;
        pinch-step-threshold = <600000>;
    };

    /* Function module: normalized session frames are classified before pointer
     * handling. / 正規化session frameをポインタ処理前にジェスチャー種別へ
     * 振り分ける。 */




    /* No HID listener or processors on this private observation source.
     * 専用観測sourceにはHID listener・processorを接続しない。 */


    /* Scroll inertia observes canonical, axis-locked pointer wheel events and
     * sends its decay back through the same pointer listener chain.
     * スクロール慣性は標準ポインタの軸ロック済みホイール値を観測し、減衰値を同じ
     * ポインタlistener chainへ戻す。 */


    /* Contact arbiter: the session manager is the sole raw subscriber and
     * republishes normalized frames. All primary ownership is resolved here;
     * observer continuations are explicitly delegated by the live token.
     * contact arbiter: session managerだけが生入力を購読して正規化frameを再配信
     * する。全primaryの所有権はここで解決し、observerの継続出力はlive tokenから
     * 明示的に委譲する。 */


    /* Function module: one/two/three-finger tap maps to left/right/middle.
     * A nearby second tap with the same number of fingers starts a drag when
     * held. It receives session-republished frames so the contact arbiter
     * controls exclusive ownership while tap history remains available.
     * 1/2/3本指タップを左/右/中クリックへ変換する。近い位置で同本数の二回目を
     * ホールドするとドラッグを開始する。session再配信frameを受けるため、タップ履歴を
     * 維持しつつ排他所有権はcontact arbiterが制御する。 */


    /* Edge continuation: a confirmed drag emits timer-driven pointer motion,
     * and an axis-locked 2F scroll emits wheel motion, only while the relevant
     * arbiter token remains live.
     * エッジ継続: 確定ドラッグはタイマー駆動ポインタ移動を、軸ロック済み2本指
     * スクロールはホイール移動を出力する。いずれもarbiter tokenがliveな間だけ
     * 継続する。 */
    iqs9150_edge_hold_continue: iqs9150_edge_hold_continue {
        compatible = "zmk,travelers-pad-iqs9150-edge-hold-continue";
        drag-input-device = <&iqs9150_session>;
        scroll-input-device = <&iqs9150_router>;
        scroll-motion-input-device = <&iqs9150_pointer>;
        scroll-output-device = <&iqs9150_pointer>;
        surface-x = <2000>;
        surface-y = <1213>;
        edge-size = <80>;
        drag-start-delay-ms = <120>;
        drag-repeat-ms = <24>;
        drag-repeat-delta = <8>;
        scroll-start-delay-ms = <120>;
        scroll-repeat-ms = <24>;
        scroll-repeat-delta = <4>;
        status = "okay";
    };

    /* Optional function module: short one-finger taps become virtual KSCAN
     * cells. It is disabled by default so ordinary one-finger tap remains a
     * mouse click. Enable it together with a matching chosen zmk,kscan and
     * matrix transform/keymap when gesture-layer input is wanted.
     *
     * 任意の機能モジュール: 短い1本指タップを仮想KSCANセルへ変換する。通常の
     * 1本指タップを左クリックとして維持するため、初期状態では無効にする。 */
    iqs9150_grid: iqs9150_grid {
        compatible = "zmk,travelers-pad-iqs9150-grid-kscan";
        status = "disabled";
        input-device = <&iqs9150_session>;
        rows = <3>;
        columns = <3>;
        surface-x = <2000>;
        surface-y = <1213>;
        edge-size = <100>;
        /* left, right, top, bottom: each item is <row column>. */
        edge-keys = <2 0>, <2 1>, <2 2>, <1 1>;
        tap-max-ms = <350>;
        tap-max-move = <75>;
    };

    /* Forward function-module output to ZMK's mouse HID endpoint.
     * 機能モジュールの出力をZMKのマウスHIDエンドポイントへ転送する。 */




    iqs9150_edge_hold_continue_listener: iqs9150_edge_hold_continue_listener {
        compatible = "zmk,input-listener";
        device = <&iqs9150_edge_hold_continue>;
        /* Drag REL_X/Y is forwarded directly here. Edge-held wheel output is
         * deliberately sent to &iqs9150_pointer, so it reuses exactly the
         * normal 2F listener processor chain.
         * ドラッグREL_X/Yはここから直接転送する。エッジ保持中のホイール出力は
         * &iqs9150_pointerへ送るため、通常の2本指と完全に同じlistener processor
         * chainを再利用する。 */
        status = "okay";
    };

    /* zmk-input-matrix is an optional grid source; it has no mapped key
     * positions in this step. The listener nevertheless validates the whole
     * input-processor -> KSCAN proxy -> composite path at build/run time.
     * zmk-input-matrixは任意の格子ソースであり、この段階では論理キーを割り当てない。
     * ただしlistenerによってinput processor→KSCAN proxy→compositeの経路を
     * ビルド時・起動時に検証する。 */
    iqs9150_matrix_listener: iqs9150_matrix_listener {
        compatible = "zmk,input-listener";
        /* Receive the private active-touch stream, not raw IQS9150 reports.
         * 生IQS9150レポートではなく、専用の接触中ストリームを受け取る。 */
        device = <&iqs9150_matrix_input>;
        input-processors = <&management_grid_gate>;
        management {
            layers = <1>;
            input-processors = <&zip_matrix>;
        };
        /* The grid has no logical mapping in the base firmware. Keep this
         * verification-only listener off until a grid/edge module includes
         * its transform and bindings.
         * 基本ファームには格子の論理割当がない。格子/辺モジュールがtransformと
         * bindingsをincludeするまで、この検証専用listenerは無効にする。 */
        status = "disabled";
    };

    iqs9150_matrix_input: iqs9150_matrix_input {
        compatible = "zmk,travelers-pad-iqs9150-matrix-input";
        input-device = <&iqs9150_session>;
        /* A deliberate grid tap needs to survive contact-coordinate settling.
         * The matrix starts only after this interval; short intentional flicks
         * remain possible after the contact has settled.
         * 意図的な格子タップを接触座標の収束から保護する。matrixはこの時間後に
         * 開始するため、接触が安定した後でも短い意図的フリックは可能である。 */
        one-finger-settle-ms = <80>;
        status = "disabled";
    };
};

&iqs9150_tap_drag_listener {
    input-processors = <&management_host_gate>;
};
&iqs9150_tap_drag {
    disabled-layer = <1>;
};
&iqs9150_edge_hold_continue_listener {
    input-processors = <&management_host_gate>;
};
&iqs9150_pointer_listener {
    management {
        layers = <1>;
        input-processors = <&management_host_gate>;
    };
};

/* Management 2x3 grid input processor. It observes the private matrix stream:
 * Zephyr fans a mutable input event out to every listener, so it must not
 * suppress session frames consumed by pointer, tap-drag, or multi-finger
 * modules. / 格子用input processorは専用matrixストリームを監視する。Zephyrは
 * 可変input eventを全listenerへ配信するため、ポインタ、タップドラッグ、多指moduleが
 * 消費するsession frameを抑止してはならない。 */
&kscan_gesture {
    rows = <10>;
    columns = <3>;
};

&zip_matrix {
    rows = <2>;
    columns = <3>;
    x = <2000>;
    y = <1213>;
    /* 100 is only 5% of the 2000-count X range and may be crossed by
     * pressure settling. 200 is still below the documented deliberate
     * quarter-pad flick.
     * 100はX軸2000カウントの5%で、接触圧による座標収束でも超え得る。200なら
     * 文書化した意図的な1/4パッドフリックより十分小さい。 */
    flick-threshold = <200>;
    long-press-ms = <0>;
    /* This listener receives only its private input stream. It can therefore
     * suppress its events without changing session frames seen by other modules.
     * listenerは専用ストリームだけを受けるため、抑止しても他moduleが見るsession
     * frameを変更しない。 */
    suppress-abs;
    suppress-btn-touch;
};
